{
    "name": "factoryflow/erp",
    "description": "FactoryFlow Manufacturing Production ERP",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "stripe/stripe-php": "^16.0"
    },
    "autoload": {
        "psr-4": {
            "FactoryFlow\\": "includes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
